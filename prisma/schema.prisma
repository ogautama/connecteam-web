// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  agent
  leader
}

enum Position {
  Agent
  AAB
  AB
}

enum UserStatus {
  active
  inactive
}

// id is Supabase's auth.users.id (a UUID) — set by the on_auth_user_created
// trigger, not originated by Prisma. No @default here.
model User {
  id           String     @id
  email        String     @unique
  name         String
  role         Role       @default(agent)
  createdAt    DateTime   @default(now())

  position     Position   @default(Agent)
  status       UserStatus @default(active)
  inviteCode   String     @unique @default(cuid())

  recruiterId  String?
  recruiter    User?      @relation("Recruiter", fields: [recruiterId], references: [id])
  recruits     User[]     @relation("Recruiter")
  applicants   Applicant[]
  onboardingProgress OnboardingProgress[]
  memberIntake MemberIntake?
}

// Created by a leader (Plan 02c) before the invited person ever signs in.
// Consumed (row deleted) by the on_auth_user_created trigger once that
// email completes Google sign-in and a matching User row is created.
// recruiterId/invitedBy are nullable only to bootstrap the very first
// (root) leader, who has no recruiter and wasn't invited by anyone — that
// row is inserted directly (seed script / Prisma Studio), same as root
// User.recruiterId always having been nullable. Every invite created
// through Plan 02c's UI sets both.
model PendingInvite {
  id          String   @id @default(cuid())
  email       String   @unique
  recruiterId String?
  role        Role     @default(agent)
  invitedBy   String?
  createdAt   DateTime @default(now())
}

enum LeadSource {
  calculator
  disc
  mbti
  selfMotivation
}

model Lead {
  id        String     @id @default(cuid())
  source    LeadSource
  name      String
  contact   String
  inputs    Json
  result    Json
  createdAt DateTime   @default(now())
}

enum ApplicantStatus {
  submitted
  accepted
  rejected
}

// enrolledUserId dropped (Plan 15b): account creation now happens
// exclusively through the leader-driven pending-invite flow, not by
// promoting an Applicant into a User — accepted stays a record of the
// leader's decision with no side effect on User.
model Applicant {
  id             String          @id @default(cuid())
  name           String
  email          String
  phone          String
  dob            DateTime
  idCardPhotoKey String
  recruiterId    String
  recruiter      User            @relation(fields: [recruiterId], references: [id])
  status         ApplicantStatus @default(submitted)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// Plan 07's "Join & Isi Data" onboarding item — one row per member, filled in
// from the in-app form (not the public /join Applicant flow, which is a
// pre-enrollment application; this is post-signup HR paperwork for someone
// already a User). "Unit Pengundang" isn't stored here — it's derived at
// read time from User.recruiterId so it can't go stale against a
// reassignment (see reassignRecruiter in src/lib/recruitTree.ts).
//
// Stored as plain columns for now (no field-level encryption) — Plan 07
// flagged encryption-at-rest as an open question when this item was
// deferred; the user accepted plaintext-for-now on 2026-07-29 rather than
// block the form on resolving that. Revisit if this needs hardening later.
model MemberIntake {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  ktpNumber   String
  birthDate   DateTime
  phone       String
  bankAccount String
  npwp        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Plan 07 (quest hub redesign): one row per completed checklist item, per
// member. itemId is an opaque string key owned by src/content/onboarding.ts
// (e.g. "onboarding.know-yourself") — no FK to content since content is a
// static in-repo module, not a DB table. Scoped in application code (every
// query filters by userId from requireMember()'s session) — this codebase
// has no Postgres RLS anywhere, see Plan 07's "Data model" note.
model OnboardingProgress {
  id          String   @id @default(cuid())
  userId      String
  itemId      String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, itemId])
}
