// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  agent
  leader
}

enum Position {
  Agent
  AAB
  AB
}

enum UserStatus {
  active
  inactive
}

// id is Supabase's auth.users.id (a UUID) — set by the on_auth_user_created
// trigger, not originated by Prisma. No @default here.
model User {
  id           String     @id
  email        String     @unique
  name         String
  role         Role       @default(agent)
  createdAt    DateTime   @default(now())

  position     Position   @default(Agent)
  status       UserStatus @default(active)
  inviteCode   String     @unique @default(cuid())

  recruiterId  String?
  recruiter    User?      @relation("Recruiter", fields: [recruiterId], references: [id])
  recruits     User[]     @relation("Recruiter")
  applicants   Applicant[]
  onboardingProgress OnboardingProgress[]
  memberIntake MemberIntake?
}

// Created by a leader (Plan 02c) before the invited person ever signs in.
// Consumed (row deleted) by the on_auth_user_created trigger once that
// email completes Google sign-in and a matching User row is created.
// recruiterId/invitedBy are nullable only to bootstrap the very first
// (root) leader, who has no recruiter and wasn't invited by anyone — that
// row is inserted directly (seed script / Prisma Studio), same as root
// User.recruiterId always having been nullable. Every invite created
// through Plan 02c's UI sets both.
model PendingInvite {
  id          String   @id @default(cuid())
  email       String   @unique
  recruiterId String?
  role        Role     @default(agent)
  invitedBy   String?
  createdAt   DateTime @default(now())
}

enum LeadSource {
  calculator
  disc
  mbti
  selfMotivation
}

model Lead {
  id        String     @id @default(cuid())
  source    LeadSource
  name      String
  contact   String
  inputs    Json
  result    Json
  createdAt DateTime   @default(now())
}

enum ApplicantStatus {
  submitted
  accepted
  rejected
}

// enrolledUserId dropped (Plan 15b): account creation now happens
// exclusively through the leader-driven pending-invite flow, not by
// promoting an Applicant into a User — accepted stays a record of the
// leader's decision with no side effect on User.
//
// Field set aligned with MemberIntake (2026-07-30): the public /join
// application form shows the same 16-question form as the member "Isi
// Data" page, not the original lighter (name/email/phone/dob/ID photo)
// scope Plan 15 sketched — the user asked to show "the same form"
// verbatim. Unlike MemberIntake, "accepted" does *not* auto-create a
// PendingInvite — the user chose to keep that a manual step for the
// leader (via the existing Add Member form), rather than build the
// auto-invite path this round. recruiterId is still resolved from the
// chosen "Pengundang / Unit" leader at submission time, so it stays a
// real FK (not a duplicated name string like MemberIntake.pengundangUnit)
// — this is what reassignRecruiter (src/lib/recruitTree.ts) operates on
// before a leader decides.
model Applicant {
  id                 String          @id @default(cuid())
  recruiterId        String
  recruiter          User            @relation(fields: [recruiterId], references: [id])
  status             ApplicantStatus @default(submitted)
  fullName           String
  ktpNumber          String
  birthPlace         String
  birthDate          DateTime
  activeEmail        String
  activePhone        String
  address            String
  education          EducationLevel
  schoolName         String
  graduationYear     String
  ktpPhotoKey        String
  selfiePhotoKey     String
  familyCardPhotoKey String
  savingsPhotoKey    String
  // Only required "jika sudah berkeluarga" (if married) on the source form.
  spousePhotoKey     String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

enum EducationLevel {
  smaSltaSmk
  s1
  s2
  s3
}

// Plan 07's "Isi Data" onboarding item — one row per member, filled in from
// its own full-page form (src/app/member/isi-data), not the public /join
// Applicant flow (a pre-enrollment application; this is post-signup HR
// paperwork for someone already a User). Field set and "Pengundang / Unit"
// options (src/lib/memberIntake.ts's PENGUNDANG_UNIT_OPTIONS) are copied
// from the real Google Form this replaces — not fabricated — since that
// form is otherwise gated behind a sign-in wall.
//
// Photo fields store an opaque Supabase Storage key (bucket
// "member-intake"), never bytes in Postgres — same convention as
// Applicant.idCardPhotoKey above.
//
// Stored as plain columns for now (no field-level encryption) — Plan 07
// flagged encryption-at-rest as an open question when this item was
// deferred; the user accepted plaintext-for-now on 2026-07-29 rather than
// block the form on resolving that. Revisit if this needs hardening later.
model MemberIntake {
  id                 String         @id @default(cuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id])
  fullName           String
  ktpNumber          String
  birthPlace         String
  birthDate          DateTime
  activeEmail        String
  activePhone        String
  address            String
  education          EducationLevel
  schoolName         String
  graduationYear     String
  ktpPhotoKey        String
  selfiePhotoKey     String
  familyCardPhotoKey String
  savingsPhotoKey    String
  // Only required "jika sudah berkeluarga" (if married) on the source form.
  spousePhotoKey     String?
  pengundangUnit     String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

// Plan 07 (quest hub redesign): one row per completed checklist item, per
// member. itemId is an opaque string key owned by src/content/onboarding.ts
// (e.g. "onboarding.know-yourself") — no FK to content since content is a
// static in-repo module, not a DB table. Scoped in application code (every
// query filters by userId from requireMember()'s session) — this codebase
// has no Postgres RLS anywhere, see Plan 07's "Data model" note.
model OnboardingProgress {
  id          String   @id @default(cuid())
  userId      String
  itemId      String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, itemId])
}
